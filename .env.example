# 本地开发环境变量模板（.agent/04 §2.3）
#
# 用法：
#   1. 复制为 .env（.gitignore 已忽略 *.env，禁止提交）；
#   2. 本服务**不内置 dotenv 加载器**，.env 仅作记录，启动前需在 shell 中显式注入：
#        PowerShell: $env:RIDE_DATABASE_SOURCE="postgres://用户:口令@主机:5432/gva?sslmode=disable"
#        Bash/Git Bash: export RIDE_DATABASE_SOURCE="postgres://..."
#   3. 敏感项只允许环境变量注入，禁止写入 configs/config.yaml（yaml 只保留 ${VAR} 占位）。

# 数据库连接串（必填，PostgreSQL；configs/config.yaml 中为 ${RIDE_DATABASE_SOURCE} 占位）
RIDE_DATABASE_SOURCE=

# 访问令牌签名密钥（可选；为空时启动生成进程内随机密钥，重启后旧令牌立即失效）
RIDE_JWT_SECRET=

# 联调开关：=1 时登录验证码写入服务日志，生产必须留空
RIDE_SMS_ECHO_CODE=

# 身份证哈希盐值（可选；为空时使用内置兜底盐值并打印告警，生产必须注入）
RIDE_ID_CARD_SALT=
